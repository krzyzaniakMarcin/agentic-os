# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Postgres (event log + memory + kb all live here). Local-only single-user rig;
# pick any password. DATABASE_URL is derived from these in docker-compose.yml.
POSTGRES_DB=agentic_os
POSTGRES_PASSWORD=

# Claude Code CLI auth: an API key, or a long-lived token from `claude setup-token`.
ANTHROPIC_API_KEY=

# Langfuse — self-hosted via this compose (langfuse/docker-compose.yml). The kernel
# reaches it in-network at langfuse-web:3000. The keys below match the project
# auto-provisioned on first boot (LANGFUSE_INIT_* in the langfuse compose), so
# tracing works out of the box; regenerate a real key pair in the UI to rotate.
# UI: http://localhost:3000  (login dev@agentic.local / changeme123)
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
